{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "An appointment booking request for the salon or spa.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Full name of the client."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number of the client."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the client."
        },
        "service": {
          "type": "string",
          "description": "The service requested."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The date of the appointment (ISO 8601)."
        },
        "timeSlot": {
          "type": "string",
          "description": "The selected time slot."
        },
        "notes": {
          "type": "string",
          "description": "Special requests or notes."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "cancelled"],
          "description": "Current status of the booking."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the booking was created."
        }
      },
      "required": ["fullName", "phoneNumber", "service", "date", "timeSlot"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collection of appointment bookings."
    }
  }
}
